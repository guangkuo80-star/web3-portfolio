# ─────────────────────────────────────────────────────────────
# web3-portfolio — environment variables template
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it is already in .gitignore.
# On Vercel: Settings → Environment Variables, add each key.
# ─────────────────────────────────────────────────────────────

# Your GitHub username — used to build repo links on the portfolio page
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Optional: your public contact / social handles
NEXT_PUBLIC_EMAIL=you@example.com
NEXT_PUBLIC_LINKEDIN=https://linkedin.com/in/your-handle
NEXT_PUBLIC_DISCORD=your-discord-handle

# Optional: WalletConnect project id (only if you enable wallet on portfolio)
# Get one free at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Live demo URLs (Vercel) ─────────────────────────────────
# Filled in after each demo is deployed; used for the "Live demo"
# buttons on the project cards. Leave blank while running locally.
NEXT_PUBLIC_DEMO_NFT_GALLERY=
NEXT_PUBLIC_DEMO_WALLET_DASHBOARD=
